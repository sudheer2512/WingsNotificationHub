# /etc/wings-notification-hub/worker.env — environment for wings-notification-hub-worker.service
# Owner root:wnh, mode 0640. Values here are placeholders.
#   keys:      openssl rand -base64 32      (must be the SAME values the API uses)
#   passwords: openssl rand -hex 24

Database__Provider=sqlserver
ConnectionStrings__NotificationHub=Server=sql01,1433;Database=WingsNotificationHub;User Id=wnh_app;Password=<password>;Encrypt=True
# The API creates/updates the schema.
Database__AutoCreate=false

Security__EncryptionKeys__k1=<same value as the API>
Security__ActiveKeyId=k1
Hub__PublicBaseUrl=https://notifications.example.com

# Message transport: "database" (no extra infrastructure) or "rabbitmq".
Hub__MessageTransport=rabbitmq
Messaging__RabbitMq__Uri=amqp://wnh:<password>@rabbitmq01:5672/
# Optional: shared provider rate limits and cache across instances.
Redis__Connection=redis01:6379,password=<password>,abortConnect=false

# Optional tuning / telemetry
# Workers__DispatchConcurrency=16
# OpenTelemetry__OtlpEndpoint=http://otel-collector:4317
