<?xml version="1.0" encoding="utf-8"?>
<!--
  Wings Notification Hub API on IIS (ASP.NET Core Module V2, in-process hosting).
  Copy into the publish folder (dotnet publish src/Wings.NotificationHub.Api -c Release -o C:\inetpub\WingsNotificationHub),
  replacing the generated web.config. Do NOT put secrets here: set them as app-pool / site environment variables
  (see README.md), which live in applicationHost.config outside the site folder.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Wings.NotificationHub.Api.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  startupTimeLimit="120"
                  shutdownTimeLimit="40">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Non-secret settings may live here; secrets belong in the app pool environment. -->
          <environmentVariable name="Hub__DataDirectory" value="C:\ProgramData\WingsNotificationHub" />
          <!-- TLS is terminated by the IIS https binding (bind only 443, or redirect http→https in IIS). -->
          <environmentVariable name="Https__Redirect" value="false" />
        </environmentVariables>
      </aspNetCore>

      <!-- SignalR (/hubs/inapp, /hubs/admin) uses WebSockets: the IIS "WebSocket Protocol" feature must be installed. -->
      <webSocket enabled="true" receiveBufferLimit="4194304" pingInterval="00:00:30" />

      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Attachment uploads are capped at 10 MB by the hub; allow multipart overhead. -->
          <requestLimits maxAllowedContentLength="15728640" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        </customHeaders>
      </httpProtocol>

      <!-- Long-running SignalR connections and provider callbacks should not be compressed/buffered by IIS. -->
      <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
