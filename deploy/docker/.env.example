# Wings Notification Hub — docker compose settings.
# Copy to .env (same folder as docker-compose.yml) and replace EVERY value marked <generate>.
# Never commit .env. Values below are placeholders, not working secrets.
#
# How to generate values:
#   256-bit keys (base64):         openssl rand -base64 32
#   RabbitMQ / Redis passwords:    openssl rand -hex 24          (hex: safe inside amqp:// URIs and Redis connection strings)
#   SQL Server sa password:        echo "Wnh-$(openssl rand -hex 16)-Aa1"   (meets SQL Server complexity rules, no ; or quotes)
#   On Windows without openssl:    [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))

# ── public endpoint ──
# The https URL users and providers reach (behind your reverse proxy). Used for unsubscribe links, provider
# callbacks and tracking URLs.
PUBLIC_BASE_URL=https://notifications.example.com
API_PORT=8080
# Origin of a browser app that embeds the in-app inbox (add more as Cors__Origins__1… in docker-compose.yml).
CORS_ORIGIN_0=https://erp.example.com

# ── security keys (256-bit, base64) ──
# AES-GCM key protecting provider secrets, webhook secrets and message bodies at rest. Keep it in a secret store;
# losing it makes stored secrets unreadable. To rotate: add Security__EncryptionKeys__k2 and set Security__ActiveKeyId=k2.
ENCRYPTION_KEY_K1=<generate: openssl rand -base64 32>
# HMAC key signing the hub's JWTs (admin sessions, client-credential tokens, inbox tokens). Rotating it signs everyone out.
AUTH_SIGNING_KEY=<generate: openssl rand -base64 32>

# ── first administrator (created on first start only) ──
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<generate: a strong password; change it after first sign-in>

# ── SQL Server ──
MSSQL_SA_PASSWORD=<generate: echo "Wnh-$(openssl rand -hex 16)-Aa1">
MSSQL_DATABASE=WingsNotificationHub
# Developer is free for non-production use; use Express, Standard or Enterprise (with a licence) in production.
MSSQL_PID=Developer

# ── RabbitMQ ──
RABBITMQ_USER=wnh
RABBITMQ_PASSWORD=<generate: openssl rand -hex 24>
RABBITMQ_MANAGEMENT_PORT=15672

# ── Redis (SignalR backplane, distributed cache, shared provider rate limits) ──
REDIS_PASSWORD=<generate: openssl rand -hex 24>

# ── images & scaling ──
IMAGE_REGISTRY=wings
IMAGE_TAG=latest
WORKER_REPLICAS=1

# ── optional ──
# Seed demo tenants/providers/credentials (never in production).
SEED_DEMO_DATA=false
LOG_LEVEL=Information
# OpenTelemetry OTLP endpoint, e.g. http://otel-collector:4317 (empty = disabled).
OTLP_ENDPOINT=
