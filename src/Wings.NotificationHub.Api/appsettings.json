{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http.HttpClient": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotificationHub": "Data Source=App_Data/notification-hub.db"
  },
  "Database": { "Provider": "sqlite", "AutoCreate": true },
  "Hub": {
    "PublicBaseUrl": "https://notifications.example.com",
    "DataDirectory": "App_Data",
    "MessageTransport": "database",
    "SeedDemoData": false,
    "EnableDevEndpoints": false
  },
  "Workers": { "RunInApi": true, "DispatchConcurrency": 8, "PollIntervalMs": 500, "BatchSize": 50 },
  "Security": { "RequireApprovalForCredentialChanges": true },
  "Webhooks": { "AllowHttp": false, "AllowPrivateNetworks": false },
  "RateLimiting": { "Enabled": true, "UserPerMinute": 3000, "AnonymousPerMinute": 300, "AuthPerMinute": 60 },
  "Https": { "Redirect": true },
  "Cors": { "Origins": [] }
}
