{
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning" } } },
  "ConnectionStrings": { "NotificationHub": "Data Source=../../App_Data/notification-hub.db" },
  "Hub": {
    "PublicBaseUrl": "http://localhost:5480",
