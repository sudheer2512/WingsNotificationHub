{
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http.HttpClient": "Warning" } } },
  "ConnectionStrings": { "NotificationHub": "Data Source=App_Data/notification-hub.db" },
  "Database": { "Provider": "sqlite", "AutoCreate": false },
  "Hub": { "PublicBaseUrl": "https://notifications.example.com", "DataDirectory": "App_Data", "MessageTransport": "database" },
  "Workers": { "DispatchConcurrency": 16, "PollIntervalMs": 500, "BatchSize": 50 },
  "Webhooks": { "AllowHttp": false, "AllowPrivateNetworks": false }
}
