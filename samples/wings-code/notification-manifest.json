{
  "$schema": "./notification-manifest.schema.json",
  "schemaVersion": "1.0",
  "application": {
    "code": "WINGS-FIELD-SERVICE",
    "name": "Wings Field Service",
    "description": "Generated by Wings Code: technician scheduling, job cards and customer visit updates.",
    "defaultLocale": "en",
    "sandbox": false
  },
  "companies": ["ABC"],
  "channels": ["email", "sms", "whatsapp", "inapp", "push"],
  "notificationTypes": [
    {
      "code": "JOB_ASSIGNED",
      "name": "Job assigned to technician",
      "category": "Jobs",
      "messageClass": "Transactional",
      "defaultChannels": ["inapp", "push"],
      "defaultTemplateCode": "FS_JOB_ASSIGNED_V1",
      "defaultPriority": "High",
      "events": ["job.assigned"]
    },
    {
      "code": "VISIT_SCHEDULED",
      "name": "Customer visit scheduled",
      "category": "Visits",
      "messageClass": "Transactional",
      "defaultChannels": ["whatsapp", "sms"],
      "defaultTemplateCode": "FS_VISIT_SCHEDULED_V1",
      "events": ["visit.scheduled"],
      "aiAllowed": true,
      "requiresHumanApprovalForAi": true
    },
    {
      "code": "JOB_COMPLETED",
      "name": "Job completed (customer report)",
      "category": "Jobs",
      "messageClass": "Transactional",
      "defaultChannels": ["email"],
      "defaultTemplateCode": "FS_JOB_COMPLETED_V1",
      "events": ["job.completed"]
    }
  ],
  "templates": [
    {
      "code": "FS_JOB_ASSIGNED_V1",
      "name": "Job assigned (in-app)",
      "channel": "inapp",
      "category": "Jobs",
      "subject": "New job {{JobNumber}}",
      "body": "{{CustomerName}}, {{SiteAddress}} on {{VisitDate | date:dd-MMM HH:mm}}.",
      "variables": [
        { "name": "JobNumber", "sampleValue": "JB-4471" },
        { "name": "CustomerName", "sampleValue": "Gupta Stores" },
        { "name": "SiteAddress", "sampleValue": "12 MG Road, Pune" },
        { "name": "VisitDate", "sampleValue": "2026-11-02T10:30:00+05:30" }
      ]
    },
    {
      "code": "FS_JOB_ASSIGNED_V1",
      "name": "Job assigned (push)",
      "channel": "push",
      "category": "Jobs",
      "subject": "New job {{JobNumber}}",
      "body": "{{CustomerName}} · {{VisitDate | date:dd-MMM HH:mm}}",
      "variables": [
        { "name": "JobNumber", "sampleValue": "JB-4471" },
        { "name": "CustomerName", "sampleValue": "Gupta Stores" },
        { "name": "VisitDate", "sampleValue": "2026-11-02T10:30:00+05:30" }
      ]
    },
    {
      "code": "FS_VISIT_SCHEDULED_V1",
      "name": "Visit scheduled (WhatsApp)",
      "channel": "whatsapp",
      "category": "Visits",
      "body": "Hello {{CustomerName}}, our technician {{Technician}} will visit on {{VisitDate | date:dd-MMM}} between {{Window}}. Reply to reschedule.",
      "variables": [
        { "name": "CustomerName", "sampleValue": "Gupta Stores" },
        { "name": "Technician", "sampleValue": "Imran" },
        { "name": "VisitDate", "sampleValue": "2026-11-02" },
        { "name": "Window", "sampleValue": "10:00-12:00" }
      ]
    },
    {
      "code": "FS_VISIT_SCHEDULED_V1",
      "name": "Visit scheduled (SMS)",
      "channel": "sms",
      "category": "Visits",
      "body": "Technician {{Technician}} visits on {{VisitDate | date:dd-MMM}}, {{Window}}. -{{CompanyName}}",
      "variables": [
        { "name": "Technician", "sampleValue": "Imran" },
        { "name": "VisitDate", "sampleValue": "2026-11-02" },
        { "name": "Window", "sampleValue": "10:00-12:00" }
      ]
    },
    {
      "code": "FS_JOB_COMPLETED_V1",
      "name": "Job completed (email)",
      "channel": "email",
      "category": "Jobs",
      "subject": "Service report for job {{JobNumber}}",
      "body": "<p>Dear {{CustomerName}},</p><p>Job <strong>{{JobNumber}}</strong> was completed by {{Technician}} on {{CompletedAt | date:dd-MMM-yyyy}}.</p>{{#if ReportUrl}}<p><a href=\"{{ReportUrl | url}}\">Download the service report</a></p>{{/if}}<p>Regards,<br>{{CompanyName}}</p>",
      "bodyFormat": "Html",
      "variables": [
        { "name": "CustomerName", "sampleValue": "Gupta Stores" },
        { "name": "JobNumber", "sampleValue": "JB-4471" },
        { "name": "Technician", "sampleValue": "Imran" },
        { "name": "CompletedAt", "sampleValue": "2026-11-02T13:05:00+05:30" },
        { "name": "ReportUrl", "required": false, "sampleValue": "https://field-service.wings.example/reports/JB-4471.pdf" }
      ]
    }
  ],
  "webhooks": [
    {
      "url": "https://field-service.wings.example/webhooks/notification-hub",
      "eventTypes": ["delivery.status_changed", "notification.completed", "inapp.action", "inbound.message_received"]
    }
  ],
  "credential": {
    "name": "field-service-server",
    "scopes": ["notifications.send", "notifications.read", "events.publish", "templates.read", "contacts.write", "devices.write", "preferences.read", "preferences.write", "inapp.token", "webhooks.manage"]
  }
}
